# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored, so your keys won't get committed.

# Free key from https://fdc.nal.usda.gov/api-key-signup
# If you leave this blank the app uses USDA's public DEMO_KEY, which has a low rate limit.
USDA_API_KEY=

# Not used yet in the PoC (the recipe is still mocked). Needed for the full project.
OPENAI_API_KEY=
